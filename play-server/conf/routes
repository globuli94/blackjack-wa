# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# WebSocket
GET     /websocket                  controllers.HomeController.socket

# JSON API endpoints
POST    /api/addPlayer              controllers.HomeController.addPlayerJson()
POST    /api/bet                    controllers.HomeController.betJson()
GET     /api/hit                    controllers.HomeController.hitJson()
GET     /api/stand                  controllers.HomeController.standJson()
GET     /api/doubleDown             controllers.HomeController.doubleDownJson()
GET     /api/leavePlayer            controllers.HomeController.leavePlayerJson()
GET     /api/gameState              controllers.HomeController.getGameStateJson()
GET     /api/initializeGame         controllers.HomeController.initializeGameJson()
GET     /api/startGame              controllers.HomeController.startGameJson()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
